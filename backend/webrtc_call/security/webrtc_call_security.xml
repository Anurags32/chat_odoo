<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_webrtc" model="ir.module.category">
        <field name="name">WebRTC Calling</field>
        <field name="description">Manage WebRTC Calls and Device Push Registrations</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_webrtc_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_webrtc"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_webrtc_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_webrtc"/>
        <field name="implied_ids" eval="[(4, ref('group_webrtc_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rule: User only sees calls where they are caller or callee -->
    <record id="rule_webrtc_call_user" model="ir.rule">
        <field name="name">WebRTC Call: Own Calls Only</field>
        <field name="model_id" ref="model_webrtc_call"/>
        <field name="groups" eval="[(4, ref('group_webrtc_user'))]"/>
        <field name="domain_force">['|', ('caller_id', '=', user.partner_id.id), ('callee_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Record Rule: Administrator can see all calls -->
    <record id="rule_webrtc_call_manager" model="ir.rule">
        <field name="name">WebRTC Call: All Calls for Admin</field>
        <field name="model_id" ref="model_webrtc_call"/>
        <field name="groups" eval="[(4, ref('group_webrtc_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Record Rule: Device tokens (Own devices only) -->
    <record id="rule_webrtc_device_user" model="ir.rule">
        <field name="name">WebRTC Device: Own Devices Only</field>
        <field name="model_id" ref="model_webrtc_device"/>
        <field name="groups" eval="[(4, ref('group_webrtc_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_webrtc_device_manager" model="ir.rule">
        <field name="name">WebRTC Device: All Devices for Admin</field>
        <field name="model_id" ref="model_webrtc_device"/>
        <field name="groups" eval="[(4, ref('group_webrtc_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
