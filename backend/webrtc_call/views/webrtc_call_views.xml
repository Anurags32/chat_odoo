<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_webrtc_call_tree" model="ir.ui.view">
        <field name="name">webrtc.call.list</field>
        <field name="model">webrtc.call</field>
        <field name="arch" type="xml">
            <list string="WebRTC Calls" decoration-danger="state in ('missed', 'failed', 'rejected')" decoration-success="state == 'ended'" decoration-info="state in ('ringing', 'accepted')" default_order="start_time desc">
                <field name="start_time" string="Time"/>
                <field name="caller_id"/>
                <field name="callee_id"/>
                <field name="call_type" widget="badge"/>
                <field name="state" widget="badge" decoration-success="state == 'ended'" decoration-info="state in ('ringing', 'accepted')" decoration-warning="state == 'busy'" decoration-danger="state in ('missed', 'rejected', 'failed', 'cancelled')"/>
                <field name="duration_formatted" string="Duration"/>
                <field name="end_reason" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_webrtc_call_form" model="ir.ui.view">
        <field name="name">webrtc.call.form</field>
        <field name="model">webrtc.call</field>
        <field name="arch" type="xml">
            <form string="WebRTC Call">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="ringing,accepted,ended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Participants">
                            <field name="caller_id" widget="res_partner_many2one"/>
                            <field name="callee_id" widget="res_partner_many2one"/>
                            <field name="call_type"/>
                        </group>
                        <group string="Timings &amp; Duration">
                            <field name="start_time"/>
                            <field name="answer_time" invisible="not answer_time"/>
                            <field name="end_time" invisible="not end_time"/>
                            <field name="duration_formatted" string="Duration"/>
                            <field name="end_reason" invisible="not end_reason"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search / Filter View -->
    <record id="view_webrtc_call_search" model="ir.ui.view">
        <field name="name">webrtc.call.search</field>
        <field name="model">webrtc.call</field>
        <field name="arch" type="xml">
            <search string="Search Calls">
                <field name="caller_id"/>
                <field name="callee_id"/>
                <filter string="My Calls" name="my_calls" domain="['|', ('caller_id.user_ids', 'in', [uid]), ('callee_id.user_ids', 'in', [uid])]"/>
                <separator/>
                <filter string="Audio Calls" name="audio_calls" domain="[('call_type', '=', 'audio')]"/>
                <filter string="Video Calls" name="video_calls" domain="[('call_type', '=', 'video')]"/>
                <separator/>
                <filter string="Missed Calls" name="missed_calls" domain="[('state', '=', 'missed')]"/>
                <filter string="Active / Ringing" name="active_calls" domain="[('state', 'in', ['ringing', 'accepted'])]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Call Type" name="group_by_type" context="{'group_by': 'call_type'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'start_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_webrtc_call" model="ir.actions.act_window">
        <field name="name">Calls History</field>
        <field name="res_model">webrtc.call</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_webrtc_call_search"/>
        <field name="context">{'search_default_my_calls': 1}</field>
    </record>
</odoo>
