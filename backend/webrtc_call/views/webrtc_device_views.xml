<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_webrtc_device_tree" model="ir.ui.view">
        <field name="name">webrtc.device.list</field>
        <field name="model">webrtc.device</field>
        <field name="arch" type="xml">
            <list string="Push Devices" default_order="last_seen desc">
                <field name="user_id"/>
                <field name="platform" widget="badge"/>
                <field name="device_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_webrtc_device_form" model="ir.ui.view">
        <field name="name">webrtc.device.form</field>
        <field name="model">webrtc.device</field>
        <field name="arch" type="xml">
            <form string="Push Device">
                <sheet>
                    <group>
                        <group string="Device Info">
                            <field name="user_id"/>
                            <field name="platform"/>
                            <field name="device_id"/>
                            <field name="active"/>
                            <field name="last_seen"/>
                        </group>
                        <group string="Push Tokens">
                            <field name="fcm_token"/>
                            <field name="voip_token"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_webrtc_device" model="ir.actions.act_window">
        <field name="name">Push Devices</field>
        <field name="res_model">webrtc.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
